<Window x:Class="PlainDraft.LinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ссылка"
        Width="380" SizeToContent="Height"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource PaperBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        SourceInitialized="OnSourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource PaperBrush}"
            MouseLeftButtonDown="OnDragMove">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="{StaticResource DialogContentMargin}"
                        Width="340">
                <TextBlock Text="Ссылка"
                           Style="{StaticResource DialogTitleText}"/>

                <TextBlock Text="Адрес или файл:"
                           Style="{StaticResource DialogFieldLabel}"
                           Margin="0,0,0,6"/>
                <Border x:Name="UrlFieldBorder"
                        Style="{StaticResource DialogFieldBorder}"
                        Margin="0,0,0,14">
                    <Grid>
                        <TextBlock x:Name="UrlPlaceholder"
                                   Text="URL или путь к файлу (например C:\Docs\note.pdf)"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="UrlBox"
                                 Style="{StaticResource DialogFieldTextBox}"
                                 TextChanged="OnUrlTextChanged"
                                 GotFocus="OnUrlGotFocus"
                                 LostFocus="OnFieldLostFocus"
                                 KeyDown="OnUrlKeyDown"/>
                    </Grid>
                </Border>

                <TextBlock Text="Текст для отображения:"
                           Style="{StaticResource DialogFieldLabel}"
                           Margin="0,0,0,6"/>
                <Border x:Name="DisplayFieldBorder"
                        Style="{StaticResource DialogFieldBorder}">
                    <Grid>
                        <TextBlock x:Name="DisplayPlaceholder"
                                   Text="Текст для ссылки (необязательно)"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="DisplayBox"
                                 Style="{StaticResource DialogFieldTextBox}"
                                 TextChanged="OnDisplayTextChanged"
                                 GotFocus="OnDisplayGotFocus"
                                 LostFocus="OnFieldLostFocus"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource DialogFooterBar}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Width="96" Height="34"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="OnCancel"
                            Style="{StaticResource DialogSecondaryButton}"/>
                    <Button x:Name="InsertButton"
                            Content="Вставить"
                            Width="96" Height="34"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="OnInsert"
                            Style="{StaticResource DialogPrimaryButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
