<Window x:Class="PlainDraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрые заметки"
        Width="420" Height="594"
        MinWidth="403" MinHeight="285"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource PaperBrush}"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Loaded="OnLoaded"
        Closing="OnClosing"
        SourceInitialized="OnSourceInitialized"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="PaperRoot"
          Background="{DynamicResource PaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PaperBrush}"
                Padding="20,20,20,18">
            <ContentControl x:Name="SearchChrome"
                            Style="{StaticResource MainChromeBar}"
                            Padding="{StaticResource MainChromeBarPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="15" Height="15"
                          Stretch="Uniform"
                          Fill="{DynamicResource MutedBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Data="M9.5,3A6.5,6.5 0 1,0 16,9.5A6.5,6.5 0 0,0 9.5,3M9.5,4.5A5,5 0 1,1 4.5,9.5A5,5 0 0,1 9.5,4.5M15.7,14.3L20.3,18.9L18.9,20.3L14.3,15.7Z"/>

                    <Grid Grid.Column="1" Margin="0,0,4,0">
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Найти"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="{DynamicResource InkBrush}"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource InkBrush}"
                                 SelectionBrush="{DynamicResource SelectionBrush}"
                                 SelectionTextBrush="{DynamicResource InkBrush}"
                                 SelectionOpacity="1"
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown"/>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SearchStatusText"
                                   Text=""
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   MinWidth="36"
                                   TextAlignment="Right"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <Border x:Name="SearchChromeSeparator"
                                Width="1"
                                Height="16"
                                Margin="2,0,4,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SeparatorBrush}"
                                Visibility="Collapsed"/>
                        <Button x:Name="SearchNextButton"
                                Style="{StaticResource SearchChromeButton}"
                                Content="↓"
                                ToolTip="Следующее совпадение"
                                Visibility="Collapsed"
                                Click="OnSearchNextClick"/>
                        <Button x:Name="SearchPrevButton"
                                Style="{StaticResource SearchChromeButton}"
                                Content="↑"
                                ToolTip="Предыдущее совпадение"
                                Visibility="Collapsed"
                                Click="OnSearchPrevClick"/>
                        <Button x:Name="SearchClearButton"
                                Style="{StaticResource SearchChromeButton}"
                                Content="✕"
                                FontSize="11"
                                ToolTip="Очистить"
                                Visibility="Collapsed"
                                Click="OnSearchClearClick"/>
                        <Border Width="1"
                                Height="16"
                                Margin="4,0,2,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SeparatorBrush}"/>
                        <Button x:Name="TagsButton"
                                Style="{StaticResource SearchChromeButton}"
                                Content="#"
                                FontSize="14"
                                FontWeight="SemiBold"
                                ToolTip="Метки"
                                Click="OnTagsClick"/>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Border>

        <RichTextBox x:Name="Editor"
                     Grid.Row="1"
                     Margin="24,0,4,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,4,0"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     FontWeight="Normal"
                     Foreground="{DynamicResource InkBrush}"
                     CaretBrush="{DynamicResource InkBrush}"
                     SelectionBrush="{DynamicResource SelectionBrush}"
                     SelectionTextBrush="{DynamicResource InkBrush}"
                     SelectionOpacity="0.4"
                     AcceptsTab="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     TextChanged="OnEditorTextChanged"
                     LostKeyboardFocus="OnEditorLostKeyboardFocus"
                     SelectionChanged="OnEditorSelectionChanged"
                     ContextMenuOpening="OnEditorContextMenuOpening"
                     PreviewMouseLeftButtonDown="OnEditorPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnEditorPreviewMouseMove"
                     MouseLeave="OnEditorMouseLeave">
            <RichTextBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource PlainScrollBar}"/>
                <Style TargetType="FlowDocument">
                    <Setter Property="PagePadding" Value="0"/>
                    <Setter Property="TextAlignment" Value="Left"/>
                </Style>
                <Style TargetType="List">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="20,0,0,0"/>
                    <Setter Property="MarkerOffset" Value="0"/>
                </Style>
                <Style TargetType="ListItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
                <Style TargetType="Hyperlink">
                    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                    <Setter Property="ToolTip" Value="Ctrl+клик — открыть ссылку"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <Border Grid.Row="2"
                Background="{DynamicResource PaperBrush}"
                Padding="20,12,20,20">
            <ContentControl x:Name="ToolbarChrome"
                            Style="{StaticResource MainChromeBar}"
                            Padding="{StaticResource MainChromeBarPadding}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnHeadingClick"
                            ToolTip="Заголовки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="H1" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnListClick"
                            ToolTip="Списки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="≡" FontSize="16"/>
                            <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="BtnBold" Style="{StaticResource ToolbarToggleButton}"
                                  Click="OnBoldClick" FontWeight="Bold" Content="B"
                                  ToolTip="Полужирный (Ctrl+B)"/>
                    <ToggleButton x:Name="BtnItalic" Style="{StaticResource ToolbarToggleButton}"
                                  Click="OnItalicClick" FontStyle="Italic" Content="I"
                                  ToolTip="Курсив (Ctrl+I)"/>
                    <ToggleButton x:Name="BtnUnderline" Style="{StaticResource ToolbarToggleButton}"
                                  Click="OnUnderlineClick"
                                  ToolTip="Подчёркнутый (Ctrl+U)">
                        <TextBlock Text="U" TextDecorations="Underline"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnStrike" Style="{StaticResource ToolbarToggleButton}"
                                  Click="OnStrikeClick"
                                  ToolTip="Зачёркнутый (Ctrl+Shift+X)">
                        <TextBlock Text="S" TextDecorations="Strikethrough"/>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnLinkClick"
                            ToolTip="Ссылка (Ctrl+K)">
                        <Path Width="15" Height="15"
                              Stretch="Uniform"
                              Fill="{DynamicResource InkBrush}"
                              Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z"/>
                    </Button>
                    <Border Width="1" Height="16"
                            Background="{DynamicResource SeparatorBrush}"
                            Margin="6,0,4,0"
                            VerticalAlignment="Center"/>
                    <ToggleButton x:Name="BtnVoice"
                                  Style="{StaticResource ToolbarToggleButton}"
                                  Checked="OnVoiceChecked"
                                  Unchecked="OnVoiceUnchecked"
                                  ToolTip="Голосовой ввод (Win+H)">
                        <Path Width="14" Height="14"
                              Stretch="Uniform"
                              Fill="{DynamicResource InkBrush}"
                              Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
                    </ToggleButton>
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</Window>
