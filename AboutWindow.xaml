<Window x:Class="PlainDraft.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="380" SizeToContent="Height"
        MinWidth="380"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource PaperBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        SourceInitialized="OnSourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource PaperBrush}"
            MouseLeftButtonDown="OnDragMove">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Margin="{StaticResource DialogContentMargin}"
                        Width="340">
                <TextBlock Text="О программе"
                           Style="{StaticResource DialogTitleText}"/>

                <Border x:Name="LogoMark"
                        Width="56" Height="56"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource InkBrush}"/>
                <TextBlock Text="Быстрые заметки"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="Идеи рождаются на чистом листе. Фиксируйте их в Plain Draft: Quick Notes"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,12"
                           LineHeight="20"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="VersionText"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center">
                    <Hyperlink x:Name="UpdateLink"
                               RequestNavigate="OnNavigate"
                               Foreground="{DynamicResource LinkBrush}">
                        Скачать актуальный релиз на GitHub
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource DialogFooterBar}">
                <Button Content="OK"
                        Width="96"
                        Height="34"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnOk"
                        Style="{StaticResource DialogPrimaryButton}"/>
            </Border>
        </Grid>
    </Border>
</Window>
