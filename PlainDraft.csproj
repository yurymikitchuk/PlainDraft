<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\PlainDraft.ico</ApplicationIcon>
    <AssemblyName>PlainDraft</AssemblyName>
    <RootNamespace>PlainDraft</RootNamespace>
    <Version>0.1.6</Version>
    <Product>Plain Draft: Quick Notes</Product>
    <PlatformTarget>x86</PlatformTarget>

    <!-- Size: drop PDBs and unused satellite assemblies from publish. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\content_default.rtf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PlainDraft_16.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PlainDraft_256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
